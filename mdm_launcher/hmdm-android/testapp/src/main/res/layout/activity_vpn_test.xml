<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ASR-0214/0215/0216/0217/0218 VPN control"
                    android:textStyle="bold"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ASR-0215 configure / ASR-0216 delete / ASR-0217 list / ASR-0218 start+disconnect"
                    android:textStyle="bold"/>

            <Button
                    android:id="@+id/btn_vpn_add_pptp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add PPTP Profile (test_vpn)"/>

            <Button
                    android:id="@+id/btn_vpn_add_l2tp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add L2TP/IPSec PSK Profile (test_vpn)"/>

            <Button
                    android:id="@+id/btn_vpn_add_ipsec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add IPSec XAUTH PSK Profile (test_vpn)"/>

            <Button
                    android:id="@+id/btn_vpn_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="List VPN Profiles"/>

            <Button
                    android:id="@+id/btn_vpn_delete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Delete Profile (test_vpn)"/>

            <Button
                    android:id="@+id/btn_vpn_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Profile (test_vpn, verification aid)"/>

            <Button
                    android:id="@+id/btn_vpn_disconnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disconnect VPN"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ASR-0214 disable / enable VPN (always-on lockdown + hidden settings)"
                    android:textStyle="bold"/>

            <Button
                    android:id="@+id/btn_vpn_disabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Set VPN Disabled"/>

            <Button
                    android:id="@+id/btn_vpn_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Set VPN Enabled"/>

            <Button
                    android:id="@+id/btn_vpn_query"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Query VPN Disabled State"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Local probes"
                    android:textStyle="bold"/>

            <Button
                    android:id="@+id/btn_vpn_try_open_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Probe: Open VPN Settings Activity"/>

            <Button
                    android:id="@+id/btn_vpn_check_networks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Probe: List TRANSPORT_VPN Networks"/>
        </LinearLayout>
    </ScrollView>

    <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:text="Log:"
            android:textSize="12sp"/>
</LinearLayout>
