<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Target package (for KillAppProcess)"
                    android:textStyle="bold"/>

            <EditText
                    android:id="@+id/et_kill_package"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="package name, e.g. com.android.settings"
                    android:inputType="text"/>

            <Button
                    android:id="@+id/btn_kill_app_process"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="End app process (ASR-0027)"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Keep packages for KillBackgroundProcesses (comma separated)"
                    android:textStyle="bold"/>

            <EditText
                    android:id="@+id/et_except"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="optional, empty = none"
                    android:inputType="text"/>

            <Button
                    android:id="@+id/btn_kill_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clean background processes (ASR-0028)"/>
        </LinearLayout>
    </ScrollView>

    <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:text="Log:"
            android:textSize="12sp"/>
</LinearLayout>
